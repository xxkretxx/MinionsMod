  "license": "MIT",
  "icon": "assets/buildminions/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.buildminions.fabric.BuildMinionsFabric"],
    "client": ["dev.buildminions.fabric.BuildMinionsFabricClient"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
